<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <BuildInParallel>false</BuildInParallel>
    <!-- xunit v3: los proyectos de test son ejecutables autonomos y corren sobre
         Microsoft Testing Platform, no sobre VSTest. Por eso desaparecen
         Microsoft.NET.Test.Sdk y xunit.runner.visualstudio. La propiedad
         TestingPlatformDotnetTestSupport es la que mantiene `dotnet test`
         funcionando igual que antes, asi que el CI no cambia. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- FluentAssertions se queda en la linea 6.x a proposito: 7.x y 8.x
         cambiaron a licencia comercial de Xceed. 6.x sigue siendo Apache-2.0. -->
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.29" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- La cadena de Microsoft Testing Platform que arrastra xunit v3 trae
         shims de la era .NET 5 marcados en desuso (via ApplicationInsights y
         Win32.Registry). Se fijan a la version moderna, que ademas ya no
         depende de Microsoft.NETCore.Platforms. Mismo patron que el pin de
         Newtonsoft.Json en la API. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
    <!-- Testcontainers arrastra SSH.NET 2025.1.0, afectado por GHSA-q939-rpr3-3284
         (escritura arbitraria de ficheros via ScpClient recursivo). Se fija a la
         primera version parcheada para que pase el audit de NuGet del CI. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AtlasBalance.API\AtlasBalance.API.csproj" />
    <ProjectReference Include="..\..\src\AtlasBalance.Watchdog\AtlasBalance.Watchdog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- V-02-04: la ACL de bin/obj bloquea la build desde MSBuild cuando se
         mezclan salidas Debug/Release antiguas. Excluirlos evita que se
         recojan como codigo. V-02-05: aplicado tambien en tests porque
         Microsoft.CodeCoverage.targets escribe a bin/ directamente. -->
    <Compile Remove="bin/**" />
    <Content Remove="bin/**" />
    <EmbeddedResource Remove="bin/**" />
    <None Remove="bin/**" />
    <Compile Remove="obj/**" />
    <Content Remove="obj/**" />
    <EmbeddedResource Remove="obj/**" />
    <None Remove="obj/**" />
  </ItemGroup>

</Project>
