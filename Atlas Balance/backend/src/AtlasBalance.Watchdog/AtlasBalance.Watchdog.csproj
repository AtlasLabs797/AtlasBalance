<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtlasBalance.Watchdog</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- V-03.01: migracion a .NET 10, linea 10.0.x. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <!-- V-03.01: Serilog.AspNetCore sigue la linea del hosting de ASP.NET Core;
         se sube a 10.0.0 junto con el resto de la migracion a .NET 10. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- V-03.01: Serilog.AspNetCore 10.0.0 exige Serilog.Sinks.File >= 7.0.0
         (downgrade detectado en restore si se deja en 6.0.0). -->
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nunca empaquetar secretos de desarrollo ni plantillas en un release publicado. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    <Content Update="appsettings.Development.json.template" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    <Content Update="appsettings.Production.json.template" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- SECURITY (P1a): PackageExtraction.cs vive fisicamente en
         AtlasBalance.API (lo usa ActualizacionService) y se enlaza aqui para
         que ElevatedUpdateRunner reutilice la misma extraccion ZIP segura
         (limites de tamano/entradas + proteccion zip-slip) al verificar y
         extraer su propia copia aislada del paquete, en vez de duplicarla. -->
    <Compile Include="..\AtlasBalance.API\Services\PackageExtraction.cs" Link="Services\PackageExtraction.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- V-02-04: la ACL de bin/obj bloquea la build desde MSBuild cuando se mezclan
         salidas Release antiguas. Excluirlos evita que se recojan como codigo. -->
    <Compile Remove="bin/**" />
    <Content Remove="bin/**" />
    <EmbeddedResource Remove="bin/**" />
    <None Remove="bin/**" />
    <Compile Remove="obj/**" />
    <Content Remove="obj/**" />
    <EmbeddedResource Remove="obj/**" />
    <None Remove="obj/**" />
  </ItemGroup>

</Project>
