{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "AccessTokenExpMinutes": 60,
    "RefreshTokenExpDays": 7
  },
  "SeedAdmin": {
    "Email": "admin@atlasbalance.local"
  },
  "Security": {
    "RequireMfaForWebUsers": true
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Ia": {
    "UseSystemProxy": false,
    "ProxyUrl": ""
  },
  "AtlasBalance": {
    "Caching": {
      "ConfigurationTtlSeconds": 120,
      "UserScopeTtlSeconds": 45,
      "IntegrationTokenTtlSeconds": 20,
      "DashboardScopeTtlSeconds": 30,
      "DashboardReferenceTtlSeconds": 300,
      "DashboardMetricsTtlSeconds": 15,
      "AuthCurrentTtlSeconds": 60,
      "TiposCambioTtlSeconds": 300,
      "SizeLimitEntries": 4096
    },
    "RateLimiting": {
      "Enabled": true,
      "WindowSeconds": 60,
      "AuthPerMinutePerIp": 10,
      "AnonymousPerMinutePerIp": 60,
      "ReadPerMinutePerUser": 300,
      "WritePerMinutePerUser": 60,
      "ExpensivePerMinutePerUser": 5,
      "LoginMaxFailedAttemptsPerAccount": 5,
      "LoginLockMinutes": 30,
      "LoginMaxFailuresPerIpAndEmail": 3,
      "LoginMaxFailuresPerIp": 7,
      "LoginFailureWindowMinutes": 15
    }
  },
  "WatchdogSettings": {
    "BaseUrl": "http://localhost:5001",
    "PostgresBinPath": "C:\\Program Files\\PostgreSQL\\16\\bin",
    "StateFilePath": "C:\\AtlasBalance\\watchdog-state.json",
    "DockerPostgresContainer": "atlas_balance_db",
    "DockerCliPath": "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe",
    "UpdateSourceRoot": "C:\\AtlasBalance\\updates",
    "UpdateInstallPath": "C:\\AtlasBalance",
    "UpdateTargetPath": "C:\\AtlasBalance\\api"
  },
  "GitHubSettings": {
    "UpdateToken": ""
  },
  "UpdateSecurity": {
    "ReleaseSigningPublicKeyPem": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost"
}
