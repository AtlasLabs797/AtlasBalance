<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtlasBalance.API</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**;obj\**" />
    <Content Remove="bin\**;obj\**" />
    <EmbeddedResource Remove="bin\**;obj\**" />
    <None Remove="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Service -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />

    <!-- Authentication -->
    <!-- V-02.07: 8.0.11 arrastraba Microsoft.IdentityModel.* 7.1.2, en desuso
         (Legacy + CriticalBugs). 8.0.29 sube el minimo transitivo a 7.7.3,
         que no esta deprecada. Salto de parche dentro de la linea 8.0.x. -->
    <!-- V-03.01: migracion a .NET 10, linea 10.0.x. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />

    <!-- Entity Framework Core + PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- V-02.07: Relational llegaba transitivamente en dos versiones distintas.
         En la API subia a 8.0.29 via EntityFrameworkCore.Design, pero Design es
         PrivateAssets=all y no fluye a los proyectos de test, que se quedaban en
         el 8.0.11 de Npgsql y rompian la compilacion con CS1705. Se declara
         explicito para que toda la solucion resuelva la misma version. -->
    <!-- V-03.01: migracion a .NET 10, linea 10.0.x. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />

    <!-- Background Jobs -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- Hangfire depends on Newtonsoft.Json; pin a non-vulnerable transitive version. App code still uses System.Text.Json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Email -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />

    <!-- Excel Export -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />

    <!-- Logging -->
    <!-- V-03.01: Serilog.AspNetCore sigue la linea del hosting de ASP.NET Core;
         se sube a 10.0.0 junto con el resto de la migracion a .NET 10. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- V-03.01: Serilog.AspNetCore 10.0.0 exige Serilog.Sinks.File >= 7.0.0
         (downgrade detectado en restore si se deja en 6.0.0). -->
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- V-03.01: System.Diagnostics.EventLog, System.Security.AccessControl y
         System.Diagnostics.DiagnosticSource vienen en el framework de .NET 10;
         NuGet los poda y sus pins daban NU1510. Se eliminan en toda la solucion. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Nunca empaquetar secretos de desarrollo ni plantillas en un release publicado. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    <Content Update="appsettings.Development.json.template" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    <Content Update="appsettings.Production.json.template" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
