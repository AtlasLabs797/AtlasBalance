<?xml version="1.0" encoding="utf-8"?>
<!--
  V-02.07: fija el unico feed valido para toda la solucion.

  El <clear /> descarta cualquier origen heredado de la configuracion de maquina
  o de usuario, para que un feed anadido en el equipo no entre en un restore sin
  que nadie lo note.

  El <packageSourceMapping> con el patron "*" apuntando solo a nuget.org es la
  defensa en profundidad contra dependency confusion: aunque manana se anada un
  segundo origen, ningun paquete se resolvera desde el sin mapearlo aqui de
  forma explicita.

  Los packages.lock.json y el restore en modo bloqueado siguen siendo la
  garantia principal de version y hash; esto cubre el escalon de "de donde".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
